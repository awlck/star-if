root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,cc,cxx,h,hpp,hh}]
indent_size = 4

[CMakeLists.txt]
indent_size = 2

[*.cmake]
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

# .star files carry their own line-ending policy (spec §2: LF or CRLF, both
# must round-trip unchanged) and are marked -text in .gitattributes, so
# editors must not be told to normalise them here. See A4 / CONTRIBUTING.md.
[*.star]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
